# ============================================================
# Daurtica — Environment Variables (template)
# ============================================================
# Salin file ini lalu isi nilainya:
#
#   cp .env.example .env.local
#
# JANGAN commit .env / .env.local yang berisi nilai asli.
# File ini hanya template kosong — aman untuk di-commit.
# ============================================================

# --- Database (WAJIB) --------------------------------------
# Connection string Postgres/Neon untuk Drizzle ORM.
# Build produksi lokal akan gagal tanpa variabel ini.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Clerk Authentication (WAJIB) --------------------------
# https://dashboard.clerk.com -> API Keys
# Diperlukan untuk prerender build dan seluruh alur login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# --- Application URL (WAJIB untuk build lokal) -------------
# Dipakai untuk sitemap/metadata dan self-fetch API saat SSR.
# Di Vercel, VERCEL_URL tersedia otomatis
# (NEXT_PUBLIC_APP_URL lebih diutamakan jika diisi).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Gemini (OPSIONAL) ------------------------------
# Tanpa key ini, fitur AI generatif memakai data mock.
GOOGLE_API_KEY=

# --- Cloudinary (WAJIB untuk upload gambar) ----------------
# https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Inngest (OPSIONAL di lokal) ---------------------------
# Default: "local-dev-key" bila kosong.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=    # untuk verifikasi webhook Inngest di production
